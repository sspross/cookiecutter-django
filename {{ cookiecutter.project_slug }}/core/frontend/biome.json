{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "includes": ["src/**/*.ts", "src/**/*.tsx", "vite.config.mjs"],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 88
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react": {
                "importNames": ["useEffect", "useLayoutEffect"],
                "message": "Effects are banned in product code. Derive state during render, handle it in the event handler, or use a hook from @/hooks."
              }
            }
          }
        },
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "setTimeout": "Timers are banned in product code. Use a hook from @/hooks.",
              "setInterval": "Timers are banned in product code. Use a hook from @/hooks.",
              "requestAnimationFrame": "Timers are banned in product code. Use a hook from @/hooks."
            }
          }
        }
      },
      "a11y": {
        "useSemanticElements": "warn"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/spa/routes/**/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": {
                    "importNames": ["useEffect", "useLayoutEffect"],
                    "message": "Effects are banned in product code. Derive state during render, handle it in the event handler, or use a hook from @/hooks."
                  }
                },
                "patterns": [
                  {
                    "group": ["@/api/client", "**/api/client"],
                    "message": "Call the API through a hook in @/queries. Types live in @/api/types."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/spa/components/**/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": {
                    "importNames": ["useEffect", "useLayoutEffect"],
                    "message": "Effects are banned in product code. Derive state during render, handle it in the event handler, or use a hook from @/hooks."
                  }
                },
                "patterns": [
                  {
                    "group": ["@/api/client", "**/api/client"],
                    "message": "Call the API through a hook in @/queries. Types live in @/api/types."
                  },
                  {
                    "group": ["@/routes/**", "**/routes/**"],
                    "message": "Only App.tsx imports routes. Direction: routes -> components -> queries -> api."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/spa/queries/**/*", "src/spa/lib/**/*", "src/spa/api/**/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": {
                    "importNames": ["useEffect", "useLayoutEffect"],
                    "message": "Effects are banned in product code. Derive state during render, handle it in the event handler, or use a hook from @/hooks."
                  }
                },
                "patterns": [
                  {
                    "group": ["@/routes/**", "**/routes/**"],
                    "message": "Only App.tsx imports routes. Direction: routes -> components -> queries -> api."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/spa/hooks/**/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/api/client", "**/api/client"],
                    "message": "Call the API through a hook in @/queries. Types live in @/api/types."
                  },
                  {
                    "group": ["@/routes/**", "**/routes/**"],
                    "message": "Only App.tsx imports routes. Direction: routes -> components -> queries -> api."
                  }
                ]
              }
            },
            "noRestrictedGlobals": "off"
          }
        }
      }
    },
    {
      "includes": ["src/spa/components/ui/**/*"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["src/spa/api/schema.d.ts"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    }
  ]
}
