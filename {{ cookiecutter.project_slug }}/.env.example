DEBUG=True
SECRET_KEY=replace-with-secret-key
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://localhost:5432/{{ cookiecutter.project_slug }}
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Redis broker URL used by django-rq for async background jobs.
REDIS_URL=redis://localhost:6379/0

# Optional: decouples django-vite's dev_mode from DEBUG. Set to False to
# serve the built manifest from `npm run build` + collectstatic while
# keeping DEBUG=True. Unset = follows DEBUG.
# DJANGO_VITE_DEV_MODE=False

# Optional: Sentry error tracking. Blank or unset leaves the SDK uninitialized.
# SENTRY_ENVIRONMENT defaults to "production"; set it only for a second
# deployment (staging) sharing the same Sentry project.
# SENTRY_DSN=

# Optional: "Sign in with Google" on the login page. A blank client id hides
# the button and unmounts the Google routes. Create the OAuth client as in
# README.md > Setup.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# SSO allowlist, comma-separated: Workspace domains and single emails allowed
# to use Google login besides the author email. See "SSO allowlist" in
# CONTEXT.md.
# SSO_ALLOWED_DOMAINS=company.com
# SSO_ALLOWED_EMAILS=someone@gmail.com

# --- Docker Compose deployment (compose.yaml, compose.prod.yaml) ---
# Only read when deploying with a compose file; local development ignores it.
# The compose files set DATABASE_URL, REDIS_URL, MEDIA_ROOT and MEDIA_URL
# themselves, so the values above do not apply there. Keep the password URL-safe:
# it is interpolated into DATABASE_URL without escaping.
POSTGRES_PASSWORD=
